# ================================================================
# CRM – Apache Configuration
# Compatible hébergement mutualisé (cPanel / LiteSpeed / Apache)
# ================================================================

Options -Indexes

# ── Security Headers ───────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options    "nosniff"
    Header always set X-Frame-Options           "SAMEORIGIN"
    Header always set X-XSS-Protection          "1; mode=block"
    Header always set Referrer-Policy           "strict-origin-when-cross-origin"

    # ── CORS pour l'API mobile ─────────────────────────────────
    Header always set Access-Control-Allow-Origin  "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Authorization, Content-Type, Accept"
</IfModule>

# ── Gérer les requêtes OPTIONS (preflight) ─────────────────────
RewriteEngine On
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule .* - [R=200,L]

# ── Protect sensitive files ────────────────────────────────────
<FilesMatch "(^config\.php|^db_setup\.sql|^error_log\.txt|^\.env)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ── Block access to hidden files (.git, .env, etc.) ───────────
<FilesMatch "^\.">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ── Block PHP execution inside uploads/ ───────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} /uploads/.*\.(php|phtml|php3|php4|php5|php7|phar)$ [NC]
    RewriteRule .* - [F,L]
</IfModule>

# ── Charset ───────────────────────────────────────────────────
AddDefaultCharset UTF-8